<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>MySimCity.BuildTools</RootNamespace>
    <AssemblyName>DefinitionValidator</AssemblyName>
    <!-- 固定输出目录（不带 $(Configuration)），便于 ValidateDefinitions.targets
         在任意配置（Debug / ExportDebug 等）下都能找到本程序集。 -->
    <OutputPath>bin\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DefinitionRules\DefinitionRules.csproj" />
  </ItemGroup>

</Project>
